{
  "$defs": {
    "Ack": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "anyOf": [
            {
              "$ref": "#/$defs/ErrorCode"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "detail": {
          "anyOf": [
            {
              "maxLength": 256,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Detail"
        },
        "id": {
          "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$",
          "title": "Id",
          "type": "string"
        },
        "rev": {
          "anyOf": [
            {
              "maximum": 9007199254740991,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rev"
        },
        "status": {
          "enum": [
            "accepted",
            "rejected"
          ],
          "title": "Status",
          "type": "string"
        },
        "type": {
          "const": "ack",
          "title": "Type",
          "type": "string"
        },
        "v": {
          "const": 1,
          "title": "V",
          "type": "integer"
        }
      },
      "required": [
        "v",
        "type",
        "id",
        "status"
      ],
      "title": "Ack",
      "type": "object"
    },
    "Acquisition": {
      "additionalProperties": false,
